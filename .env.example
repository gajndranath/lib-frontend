# Frontend Environment Configuration - Copy to .env and fill with actual values
# DO NOT COMMIT .env FILE WITH SENSITIVE DATA

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# Public Keys (these are safe to expose)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Sensitive configuration should be handled via backend-for-frontend pattern
# Never expose authentication tokens, API keys, or secrets in frontend code
